# Public canonical URL. Use https://overmcp.com in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Turso/libSQL database credentials.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Stripe Checkout and webhook signing credentials.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Random secret used only to hash click-deduplication signals.
ANALYTICS_SALT=replace-with-a-long-random-value

# Separate HMAC secret for signed website-icon autofill payloads.
METADATA_SIGNING_SECRET=replace-with-another-long-random-value
